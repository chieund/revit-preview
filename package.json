{
  "name": "revit-preview",
  "displayName": "Revit Viewer",
  "description": "Open Revit models in 3D inside VS Code — directly from .rvt (Revit 2023–2025) or .ifc. Orbit, zoom, filter element types, click any element to inspect its properties. Fully local, no Revit install needed.",
  "version": "2.0.0",
  "publisher": "bumkom",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "revit",
    "bim",
    "ifc",
    "rvt",
    "3d",
    "viewer",
    "architecture",
    "model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chieund/revit-preview"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "revit-preview.ifcViewer",
        "displayName": "Revit Viewer (IFC)",
        "selector": [
          {
            "filenamePattern": "*.ifc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "revit-preview.rvtViewer",
        "displayName": "Revit Viewer (RVT)",
        "selector": [
          {
            "filenamePattern": "*.rvt"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "puppeteer": "^25.19.0",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "web-ifc": "^0.0.68"
  }
}
